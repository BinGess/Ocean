[
  {
    "id": "q001",
    "content": "观察当下，不做评判，这就是冥想的开始",
    "author": "乔·卡巴金",
    "category": "mindfulness",
    "targetMoods": ["焦虑", "压力", "烦躁"],
    "timeContext": "morning",
    "weight": 1.2,
    "createdAt": "2024-01-01T00:00:00Z"
  },
  {
    "id": "q002",
    "content": "呼吸是回到当下最简单的方法",
    "author": "一行禅师",
    "category": "mindfulness",
    "targetMoods": ["焦虑", "紧张", "担心"],
    "timeContext": "anytime",
    "weight": 1.0,
    "createdAt": "2024-01-02T00:00:00Z"
  },
  {
    "id": "q003",
    "content": "思想来来往往，就像天空中的云。不要对它们做任何事，只需让它们经过",
    "author": "正念冥想",
    "category": "mindfulness",
    "targetMoods": ["抑郁", "无聊", "失望"],
    "timeContext": "evening",
    "weight": 1.1,
    "createdAt": "2024-01-03T00:00:00Z"
  },
  {
    "id": "q004",
    "content": "觉醒不是逃避痛苦，而是完全拥抱生活的所有方面",
    "author": "佛教智慧",
    "category": "mindfulness",
    "targetMoods": ["悲伤", "孤独", "低落"],
    "timeContext": "evening",
    "weight": 0.9,
    "createdAt": "2024-01-04T00:00:00Z"
  },
  {
    "id": "q005",
    "content": "对自己仁慈，就像对待一个亲密的朋友一样",
    "author": "克里斯汀·内夫",
    "category": "selfCompassion",
    "targetMoods": ["内疚", "自责", "失败感"],
    "timeContext": "morning",
    "weight": 1.3,
    "createdAt": "2024-01-05T00:00:00Z"
  },
  {
    "id": "q006",
    "content": "不完美是我们存在的一部分。犯错不是失败，而是学习的机会",
    "author": "自我同情冥想",
    "category": "selfCompassion",
    "targetMoods": ["完美主义", "自我批评", "羞愧"],
    "timeContext": "anytime",
    "weight": 1.2,
    "createdAt": "2024-01-06T00:00:00Z"
  },
  {
    "id": "q007",
    "content": "你的痛苦和你的快乐一样真实。没有人能更好地理解你",
    "author": "布琳·布朗",
    "category": "selfCompassion",
    "targetMoods": ["孤独", "被误解", "无力"],
    "timeContext": "evening",
    "weight": 1.1,
    "createdAt": "2024-01-07T00:00:00Z"
  },
  {
    "id": "q008",
    "content": "困难不会永远存在，但给困难贴上标签的能力会",
    "author": "斯多葛派智慧",
    "category": "stoicism",
    "targetMoods": ["低落", "失望", "绝望"],
    "timeContext": "evening",
    "weight": 1.0,
    "createdAt": "2024-01-08T00:00:00Z"
  },
  {
    "id": "q009",
    "content": "我们无法控制发生在我们身上的事，但我们可以控制如何回应",
    "author": "爱比克泰德",
    "category": "stoicism",
    "targetMoods": ["无力感", "受害者心态", "愤怒"],
    "timeContext": "morning",
    "weight": 1.2,
    "createdAt": "2024-01-09T00:00:00Z"
  },
  {
    "id": "q010",
    "content": "专注于你能控制的事。不要浪费精力在你不能改变的事上",
    "author": "马库斯·奥勒留",
    "category": "stoicism",
    "targetMoods": ["焦虑", "压力", "担心"],
    "timeContext": "morning",
    "weight": 1.1,
    "createdAt": "2024-01-10T00:00:00Z"
  },
  {
    "id": "q011",
    "content": "今天我无法改变过去，但我可以改变对过去的态度",
    "author": "斯多葛派",
    "category": "stoicism",
    "targetMoods": ["懊悔", "遗憾", "后悔"],
    "timeContext": "anytime",
    "weight": 0.9,
    "createdAt": "2024-01-11T00:00:00Z"
  },
  {
    "id": "q012",
    "content": "观察你的需要，深入倾听它们所想表达的信息",
    "author": "马歇尔·罗森伯格",
    "category": "nvc",
    "targetMoods": ["冲突", "误解", "沟通困难"],
    "timeContext": "morning",
    "weight": 1.2,
    "createdAt": "2024-01-12T00:00:00Z"
  },
  {
    "id": "q013",
    "content": "每一个感受都源于未被满足或已被满足的需要",
    "author": "非暴力沟通",
    "category": "nvc",
    "targetMoods": ["情绪困惑", "无法理解自己"],
    "timeContext": "anytime",
    "weight": 1.0,
    "createdAt": "2024-01-13T00:00:00Z"
  },
  {
    "id": "q014",
    "content": "用同理心回应别人，你会找到真正的连接",
    "author": "马歇尔·罗森伯格",
    "category": "nvc",
    "targetMoods": ["孤独", "被拒绝", "关系断裂"],
    "timeContext": "evening",
    "weight": 1.1,
    "createdAt": "2024-01-14T00:00:00Z"
  },
  {
    "id": "q015",
    "content": "请求的能力让我们从被动变为主动",
    "author": "NVC智慧",
    "category": "nvc",
    "targetMoods": ["无力感", "被忽视", "不被倾听"],
    "timeContext": "morning",
    "weight": 1.0,
    "createdAt": "2024-01-15T00:00:00Z"
  },
  {
    "id": "q016",
    "content": "静坐片刻，倾听内在的声音",
    "author": "心灵冥想",
    "category": "mindfulness",
    "targetMoods": ["困惑", "迷茫", "不确定"],
    "timeContext": "evening",
    "weight": 0.8,
    "createdAt": "2024-01-16T00:00:00Z"
  },
  {
    "id": "q017",
    "content": "生活的意义在于每一个此刻，而不仅仅是目标",
    "author": "正念生活",
    "category": "mindfulness",
    "targetMoods": ["空虚", "无意义", "倦怠"],
    "timeContext": "anytime",
    "weight": 0.9,
    "createdAt": "2024-01-17T00:00:00Z"
  },
  {
    "id": "q018",
    "content": "我正在用爱对待我自己的每个部分",
    "author": "自我接纳",
    "category": "selfCompassion",
    "targetMoods": ["自我否定", "厌烦", "焦虑"],
    "timeContext": "morning",
    "weight": 1.1,
    "createdAt": "2024-01-18T00:00:00Z"
  },
  {
    "id": "q019",
    "content": "痛苦是生活的一部分。接纳它，你就找到了力量",
    "author": "存在主义智慧",
    "category": "stoicism",
    "targetMoods": ["痛苦", "悲伤", "失落"],
    "timeContext": "evening",
    "weight": 1.0,
    "createdAt": "2024-01-19T00:00:00Z"
  },
  {
    "id": "q020",
    "content": "在我内心深处，我已经拥有我所需要的一切",
    "author": "内在力量",
    "category": "selfCompassion",
    "targetMoods": ["自信", "归属感", "充足感"],
    "timeContext": "morning",
    "weight": 1.3,
    "createdAt": "2024-01-20T00:00:00Z"
  }
]
